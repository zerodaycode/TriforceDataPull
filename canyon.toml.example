# Copy to canyon.toml (not in git) and adjust.
# Don't rename this to canyon*.toml: Canyon reads the first canyon*.toml it finds (up to 2 folders deep).
# Values match docker/docker-compose.yml.
[canyon_sql]
datasources = [
    {name = 'postgres', auth = { postgresql = { basic = { username = "postgres", password = "postgres" } } }, properties.host = 'localhost', properties.port = 5438, properties.db_name = 'postgres', properties.migrations = 'enabled' },
]
