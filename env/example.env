# Copy to env/dev.env (or any name in env/, they are not in git) and run:
#   cargo run -- --env env/dev.env
# Vars set in the shell win over the file. Same format as docker compose env_file:
# quote values with spaces, like the cron ones. $NAME is replaced by that variable,
# single quotes keep the $.
# Every line below is the default, remove the # to change it.

# new | old: leagues and tournaments from GraphQL or from the old API
#TRIFORCE_SOURCE_LEAGUES=new
# new | old: teams and players from GraphQL or from the old API
#TRIFORCE_SOURCE_TEAMS=new
# on | off: fill the v2_* tables
#TRIFORCE_V2=on
# on | off: game details from the live feed (needs TRIFORCE_V2=on), off stops only them
#TRIFORCE_V2_DETAILS=on
# on | off: live matches once a minute (needs TRIFORCE_V2=on), off stops only them
#TRIFORCE_V2_LIVE=on
# on | off: game frames, every frame of each finished game kept and 10 s series (needs TRIFORCE_V2=on)
#TRIFORCE_V2_FRAMES=on
# on | off: series of the games being played, every 10 s (needs TRIFORCE_V2_FRAMES=on)
#TRIFORCE_V2_FRAMES_LIVE=on
# on | off: jobs that work through the history. off = only the last 3 days.
# A backfill needs the matches: MATCHES=off on an empty DB leaves the others nothing old to work on
# v2 matches: full pass from 2023-10-01 once a day
#TRIFORCE_BACKFILL_MATCHES=on
# v2 game details for every finished game
#TRIFORCE_BACKFILL_DETAILS=on
# v2 game frames for every finished game (days of feed calls, ~5-6 GB archive + ~2 GB series)
#TRIFORCE_BACKFILL_FRAMES=off
# Extra locales for the v2 names, comma list like es-ES,ko-KR (en-US is always pulled)
#TRIFORCE_LOCALES=
# Where the GraphQL query manifest is kept
#TRIFORCE_GQL_MANIFEST=gql-manifest.json

# Loop schedules, cron with seconds (sec min hour day month weekday)
#TRIFORCE_CRON_LEAGUES="0 0 */2 ? * *"
#TRIFORCE_CRON_TOURNAMENTS="0 0 */2 ? * *"
#TRIFORCE_CRON_TEAMS="0 0 * ? * *"
#TRIFORCE_CRON_SCHEDULE="0 */30 * ? * *"
#TRIFORCE_CRON_LIVE="0 */2 * ? * *"
#TRIFORCE_CRON_V2="0 15 */2 ? * *"
#TRIFORCE_CRON_V2_MATCHES="0 5,35 * ? * *"
#TRIFORCE_CRON_V2_LIVE="30 * * ? * *"
